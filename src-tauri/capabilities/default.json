{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Local recording, transcription, explicit copy and resident app preferences for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "allow-recording-status",
    "allow-recording-level",
    "allow-request-microphone-permission",
    "allow-start-recording",
    "allow-stop-recording",
    "allow-clear-recording",
    "allow-open-microphone-settings",
    "allow-load-model",
    "allow-transcribe-recording",
    "allow-copy-transcript",
    "allow-desktop-status",
    "allow-save-preferences",
    "allow-insertion-status",
    "allow-context-status",
    "allow-request-screen-permission",
    "allow-correct-transcript",
    "allow-correction-status",
    "allow-copy-correction",
    "allow-check-foundation-model",
    "allow-copy-foundation-diagnostics",
    "allow-request-accessibility",
    "allow-model-catalog",
    "allow-model-preparation-status",
    "allow-prepare-models",
    "allow-cancel-model-preparation",
    "allow-comparison-models",
    "allow-comparison-plan",
    "allow-comparison-status",
    "allow-start-comparison",
    "allow-cancel-comparison",
    "allow-arm-comparison-context",
    "allow-copy-comparison-result",
    "allow-update-status",
