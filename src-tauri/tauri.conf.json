{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Voice Input",
  "version": "0.1.0",
  "identifier": "dev.toyb0x.voiceinput",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Voice Input",
        "width": 760,
        "height": 940,
        "minWidth": 360,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'; img-src 'self' asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost",
      "devCsp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; img-src 'self'; connect-src 'self' ipc: http://ipc.localhost ws://127.0.0.1:1420"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "macOS": {
      "minimumSystemVersion": "27.0",
      "entitlements": "Entitlements.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "resources/local-correction": "bin/local-correction",
      "resources/apple-foundation-correction": "bin/apple-foundation-correction",
      "resources/CORRECTION-NOTICES.txt": "CORRECTION-NOTICES.txt",
      "resources/compare-transcription": "bin/compare-transcription",
      "resources/context-lab-native": "bin/context-lab-native",
      "../evaluation/context-evidence/assets/storm.png": "lab/storm.png",
      "../evaluation/context-evidence/assets/candy.png": "lab/candy.png",
      "../evaluation/context-evidence/baseline/fixtures/speech.wav": "lab/speech.wav",
      "../evaluation/context-evidence/assets/rainfall.png": "lab/rainfall.png",
      "../evaluation/context-evidence/assets/candy-shower.png": "lab/candy-shower.png",
      "resources/speech-falling.wav": "lab/speech-falling.wav"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ToyB0x/voice-input/releases/latest/download/latest.json"
      ],
      "pubkey": "",
      "requireSignedVersion": true,
      "allowDowngrades": false
    }
  }
}
