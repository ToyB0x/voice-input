{
  "name": "voice-input",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27"
  },
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "build": "pnpm run check && vite build",
    "preview": "vite preview",
    "tauri": "pnpm run prepare-native && tauri",
    "prepare-native": "python3 scripts/prepare-native-runtime.py",
    "check:dependencies": "python3 scripts/check-dependency-age.py",
    "test:ui": "node --disable-warning=ExperimentalWarning --experimental-vm-modules --test scripts/tests/*.test.mjs"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4"
  },
  "packageManager": "pnpm@12.16.1"
}
